# ---------------------------------------------------------------------------
# BakaSU (formerly ReSukiSU) + SUSFS
# Merged on top of LineageOS' gki_defconfig + vendor fragments for cupid.
# ---------------------------------------------------------------------------

# KernelSU / BakaSU core
CONFIG_KSU=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y

# Hook mode: SUSFS inline hook (replaces the tracepoint/manual hook choice)
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set
CONFIG_KSU_SUSFS=y

# SUSFS features
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# Avoid BakaSU's static-export compatibility patches.
# (The GKI config already sets this, keep it explicit.)
CONFIG_KALLSYMS_ALL=y

# Never append -g<commit>-dirty to the release string. The patched tree is
# always dirty, and the resulting vermagic would not match the vendor modules.
# build.sh hardcodes the exact stock suffix via CONFIG_LOCALVERSION instead.
# CONFIG_LOCALVERSION_AUTO is not set
